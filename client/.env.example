# DevHub client environment template
# Copy this file to `.env.local`. Values prefixed with `NEXT_PUBLIC_` are
# embedded in the browser bundle; never place secrets in this file.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# Public URL where the Next.js application is available. Used for client-side
# URLs and redirects.
NEXT_PUBLIC_APP_URL=<client-application-url>

# Current deployment environment. Use one of: development, test, staging, or
# production. This value is public and must not convey sensitive information.
NEXT_PUBLIC_APP_ENV=<client-environment>

# -----------------------------------------------------------------------------
# API and realtime services
# -----------------------------------------------------------------------------

# Base URL for the Express API, including its API prefix when one is used.
NEXT_PUBLIC_API_URL=<api-base-url>

# Public Socket.io server URL used when realtime messaging and notifications
# are implemented. Do not include a path, token, or credential in this value.
NEXT_PUBLIC_SOCKET_URL=<socket-server-url>
