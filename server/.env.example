# DevHub server environment template
# Copy this file to `.env`. Replace every placeholder through your deployment
# platform or local secret manager; do not commit the resulting `.env` file.
# The server validates NODE_ENV, HOST, PORT, TRUST_PROXY, LOG_LEVEL,
# CLIENT_URL, MONGODB_URI, RATE_LIMIT_WINDOW_MS, and RATE_LIMIT_MAX_REQUESTS
# before startup. Authentication settings are also validated before startup.

# -----------------------------------------------------------------------------
# Runtime and HTTP server
# -----------------------------------------------------------------------------

# Required runtime mode. Use one of: development, test, staging, or production.
NODE_ENV=<server-environment>

# Required network interface on which the Express server listens.
HOST=<server-host>

# Required TCP port on which the Express server listens.
PORT=<server-port>

# Number of trusted reverse-proxy hops. Production requires a positive value;
# set this for deployments behind a platform proxy so secure cookies and client
# IP rate limiting work correctly.
TRUST_PROXY=<trusted-proxy-hop-count>

# Required log severity threshold. Use one of: debug, info, warn, or error.
LOG_LEVEL=<log-level>

# -----------------------------------------------------------------------------
# Client origin and CORS
# -----------------------------------------------------------------------------

# Required canonical public URL of the Next.js client. Used as the allowed CORS
# origin and when the API needs to create links back to the client. This must
# use HTTPS when NODE_ENV is production.
CLIENT_URL=<client-application-url>

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Required MongoDB connection string for the environment-specific DevHub
# database. This is sensitive and must be supplied only through a secret manager.
MONGODB_URI=<mongodb-connection-string>

# -----------------------------------------------------------------------------
# Authentication and cookies
# -----------------------------------------------------------------------------

# Secret used to sign and verify JWTs. Generate a unique, high-entropy value
# for every environment; never reuse or commit it.
JWT_SECRET=<jwt-signing-secret>

# Lifetime applied to issued JWTs, using the duration format supported by the
# JWT library (for example, a number plus a time unit).
JWT_EXPIRES_IN=<jwt-expiration-duration>

# bcrypt work factor used when hashing passwords. Use an environment-appropriate
# integer after benchmarking the production runtime.
BCRYPT_SALT_ROUNDS=<bcrypt-salt-rounds>

# Name of the HTTP-only authentication cookie.
AUTH_COOKIE_NAME=<authentication-cookie-name>

# Cookie domain. Leave this unset in a local environment when using host-only
# cookies; supply the appropriate production domain through the secret manager.
COOKIE_DOMAIN=<cookie-domain-or-empty>

# Whether the authentication cookie is sent only over HTTPS.
COOKIE_SECURE=<true-or-false>

# SameSite policy for the authentication cookie. Use one of: lax, strict, or
# none. `none` requires `COOKIE_SECURE` to be true.
COOKIE_SAME_SITE=<cookie-same-site-policy>

# Authentication cookie lifetime in milliseconds.
COOKIE_MAX_AGE_MS=<cookie-lifetime-milliseconds>

# -----------------------------------------------------------------------------
# Request protection
# -----------------------------------------------------------------------------

# Required duration, in milliseconds, of a rate-limiting window.
RATE_LIMIT_WINDOW_MS=<rate-limit-window-milliseconds>

# Required maximum requests accepted from one client during a rate-limiting window.
RATE_LIMIT_MAX_REQUESTS=<rate-limit-request-limit>

# -----------------------------------------------------------------------------
# GitHub integration
# -----------------------------------------------------------------------------

# OAuth application client ID issued by GitHub.
GITHUB_CLIENT_ID=<github-oauth-client-id>

# OAuth application client secret issued by GitHub. Treat this as sensitive.
GITHUB_CLIENT_SECRET=<github-oauth-client-secret>

# Registered API callback URL for the GitHub OAuth flow.
GITHUB_CALLBACK_URL=<github-oauth-callback-url>

# -----------------------------------------------------------------------------
# Cloudinary uploads
# -----------------------------------------------------------------------------

# Cloudinary account cloud name.
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>

# Cloudinary API key.
CLOUDINARY_API_KEY=<cloudinary-api-key>

# Cloudinary API secret. Treat this as sensitive.
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

# -----------------------------------------------------------------------------
# Email delivery (password reset and account verification)
# -----------------------------------------------------------------------------

# SMTP server hostname.
SMTP_HOST=<smtp-host>

# SMTP server port.
SMTP_PORT=<smtp-port>

# Whether the SMTP transport uses TLS from the initial connection.
SMTP_SECURE=<true-or-false>

# SMTP account username. Treat this as sensitive.
SMTP_USER=<smtp-username>

# SMTP account password or provider-issued API key. Treat this as sensitive.
SMTP_PASSWORD=<smtp-password-or-api-key>

# Sender address displayed in DevHub emails.
EMAIL_FROM=<transactional-email-sender-address>

# Display name displayed alongside the sender address.
EMAIL_FROM_NAME=<transactional-email-sender-name>
